# Copie para .env.local e preencha. Nunca commite .env.local.

# Supabase (local: valores impressos por `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor e testes. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=

# URL pública do app (usada nos links de e-mail e no retorno do login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mostra o botão "Entrar com Google" quando o provedor estiver configurado no Supabase
NEXT_PUBLIC_AUTH_GOOGLE=false
